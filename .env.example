# Copiar a .env.local y rellenar. .env.local NUNCA se commitea.
#
# El MVP (Fase 2: DOI -> Semantic Scholar -> dashboard) arranca SIN ninguna clave.
# Semantic Scholar y OpenAlex permiten acceso anonimo con limites de tasa menores.
# Rellenar cada bloque solo cuando se llegue a la fase correspondiente.

# --- Fase 2: Semantic Scholar (opcional, sube el limite de tasa) ---
SEMANTIC_SCHOLAR_API_KEY=

# --- Fase 4: Supabase / PostgreSQL (la biblioteca) ---
# Analizar articulos funciona sin esto; solo la biblioteca lo necesita.
#
# Opcion A, Supabase en la nube: crear el proyecto en supabase.com, aplicar
#   supabase/migrations/0001_init.sql en el SQL Editor y pegar aqui la URL y
#   la service role key (Project Settings > API).
# Opcion B, pila local: `npx supabase start` levanta todo en Docker, aplica la
#   migracion solo y muestra API_URL y SERVICE_ROLE_KEY por consola.
#
# La service role key salta las politicas de acceso: solo en el servidor.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Fase 5: OpenAlex (opcional; el "polite pool" solo pide un email) ---
OPENALEX_API_KEY=

# --- Crossref: solo requiere un email de contacto ---
CROSSREF_EMAIL=

# --- Fase 7: analisis mediante IA ---
AI_API_KEY=
